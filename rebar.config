{erl_opts, [debug_info, {src_dirs, ["src", "src/bt", "src/cache_indexer", "src/common", "src/crawler", "src/hash_reader", "src/http_front", "src/local_torrent", "src/rmmseg", "src/sphinx_builder", "src/torrent", "src/tor_builder", "src/utils"]}]}.

{deps, [
    {ibrowse, ".*", {git, "https://github.com/cmullaparthi/ibrowse.git", {tag, "v4.4.2"}}},
    {bson, ".*", {git, "https://github.com/mongodb/bson-erlang.git", {tag, "v0.1.3"}}},
    {mongodb, ".*", {git, "https://github.com/kevinlynx/mongodb-erlang.git", {branch, "refactor"}}},
    {kdht, ".*", {git, "https://github.com/kevinlynx/kdht.git", "HEAD"}},
    {giza, ".*", {git, "https://github.com/kevinlynx/giza.git", "HEAD"}}
]}.
